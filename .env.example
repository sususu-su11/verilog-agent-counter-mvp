# Copy to .env, chmod 600 .env. Private operator-only VM with SSH tunnel.
APP_ENV=private
PUBLIC_BIND_HOST=127.0.0.1
PUBLIC_PORT=8000
APP_BASIC_USER=operator
APP_BASIC_PASSWORD=REPLACE_WITH_24_PLUS_RANDOM_CHARACTERS
# Host socket MUST be selected by the operator (rootless Docker recommended).
DOCKER_HOST_SOCKET=/run/user/1000/docker.sock
SANDBOX_IMAGE=verilog-sandbox:local
SANDBOX_RUNTIME=
REQUIRE_GVISOR=0
MOCK_LLM=1
USE_LOCAL_SIM=0
SKIP_MANIFEST=0
# For real calls, set MOCK_LLM=0 and key; never record credentials in Git.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
MODEL=deepseek-v4.1-flash-1017
# Explicit durable request count ceiling; NOT guaranteed account spend hard-stop.
LIVE_INFERENCE_MAX_CALLS=0
MAX_ATTEMPTS=4
SANDBOX_MAX_PARALLEL=2

# Public demo EXPLICIT opt-in only; launch via ./deploy.sh --public-mock
# APP_ENV=public_mock ; PUBLIC_BIND_HOST=0.0.0.0 ; PUBLIC_MOCK_ACK=1
# Requires MOCK_LLM=1, VULTR_INFERENCE_API_KEY empty, verified rootless Docker.
PUBLIC_MOCK_ACK=0
PUBLIC_RATE_LIMIT_PER_MIN=6
PUBLIC_GLOBAL_LIMIT_PER_MIN=60
PUBLIC_MAX_ACTIVE_JOBS=2
